APP_NAME=TaskManagerAgent
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_SECRET_KEY=change-this-super-secret
DEFAULT_TZ=America/New_York
WORK_HOURS_START=09:00
WORK_HOURS_END=17:00
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
SYNC_DATABASE_URL=sqlite:///./data/app.db
OPENAI_API_KEY=sk-...redacted...
OPENAI_MODEL=gpt-4o
OPENAI_MAX_OUTPUT_TOKENS=512
OPENAI_TEMPERATURE=0.3
OPENAI_TOP_P=1.0
N8N_WEBHOOK_URL=http://localhost:5678/webhook/email
N8N_WEBHOOK_SECRET=change-this-n8n-shared-secret
INITIAL_ADMIN_EMAIL=user@example.com
INITIAL_ADMIN_PASSWORD=change-me
LOG_LEVEL=INFO
DRY_RUN=false

